# YouTube API Configuration
YOUTUBE_API_KEY=your_youtube_api_key_here
YOUTUBE_CHANNEL_ID=your_channel_id_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# LLM Configuration (OpenAI or compatible)
LLM_API_ENDPOINT=https://api.openai.com/v1/chat/completions
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# Polling Intervals (in minutes)
TREND_SCOUT_INTERVAL=30     # 30 min default (polls frequently to detect new trends)
PULSE_MONITOR_INTERVAL=180  # 3 hours
COMMENT_POLL_INTERVAL=5     # 5 minutes

# Trend Scout Settings
TREND_SCOUT_CATEGORY=       # YouTube category ID (empty = auto-detect from your channel)
                            # Common IDs: 1=Film, 10=Music, 17=Sports, 20=Gaming,
                            # 22=People/Blogs, 23=Comedy, 24=Entertainment,
                            # 25=News, 26=Howto/Style, 27=Education, 28=Science/Tech
TREND_SCOUT_REGION=US       # Region code: US, IN, GB, CA, AU, DE, FR, JP, KR, BR, etc.

# Feature Toggles (true/false, all enabled by default)
ENABLE_TREND_SCOUT=true       # Instant alerts when NEW videos trend
ENABLE_PULSE_MONITOR=true     # Channel analytics
ENABLE_SMART_RESPONDER=true   # AI comment reply suggestions (requires LLM config)
ENABLE_COMMAND_HANDLER=true   # Telegram /stats and /trending commands
